{
  "manifest_version": 3,
  "name": "Voom Recorder",
  "version": "0.1.0",
  "description": "Record your screen and upload it to Voom.",
  "action": {
    "default_title": "Voom",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.ts",
    "type": "module"
  },
  "permissions": ["tabs", "scripting", "storage", "desktopCapture"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "externally_connectable": {
    "matches": ["https://voom-video.vercel.app/*"]
  },
  "content_scripts": [
    {
      "matches": ["https://voom-video.vercel.app/*"],
      "js": ["bridge.ts"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.html", "recorder.html", "assets/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}

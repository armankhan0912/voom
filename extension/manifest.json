{
  "manifest_version": 3,
  "name": "Voom Recorder",
  "version": "0.1.0",
  "description": "Record your screen and upload it to Voom.",
  "action": {
    "default_title": "Voom",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs"],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"]
}

# Copy to .env.local for local development. Never commit real values.

# Public app origin used for share/embed links and AssemblyAI webhooks.
# Must be set at build time on Vercel. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk — development keys locally, pk_live_/sk_live_ in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon Postgres. Use a pooled connection string on Vercel.
DATABASE_URL=

# Cloudflare R2 (server only)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# AssemblyAI (server only). Webhook secret is required in production.
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_WEBHOOK_SECRET=

# Gemini (server only) — summaries and chapters
GEMINI_API_KEY=
